# Copy to .env (never commit it) and export before running, e.g. `set -a; . ./.env; set +a`.

# Which LLM service runs the swarm: anthropic or sarvam.
# Leave empty to use whichever key below is set (Anthropic first if both are).
SWARM_LLM_PROVIDER=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides. Model defaults depend on the provider:
#   anthropic: claude-haiku-5-5 (analysts), claude-sonnet-5-5 (manager)
#   sarvam:    sarvam-105b for both
# SWARM_ANALYST_MODEL=
# SWARM_MANAGER_MODEL=
# SWARM_ANALYST_EFFORT=low        # low | medium | high | max
# SWARM_MANAGER_EFFORT=medium
# SARVAM_TEMPERATURE=0.2
# SWARM_DB=journal.db
